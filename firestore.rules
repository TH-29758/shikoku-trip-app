rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // These two shared documents intentionally allow access without login.
    match /tripData/checklist {
      allow get: if true;
      allow create: if request.resource.data.keys().hasOnly(['categories'])
        && request.resource.data.categories is list;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['categories'])
        && request.resource.data.categories is list;
    }

    match /tripData/party {
      allow get: if true;
      allow create: if request.resource.data.keys().hasOnly(['transactions'])
        && request.resource.data.transactions is list;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['transactions'])
        && request.resource.data.transactions is list;
    }

    // All other paths, collection queries and document deletes are denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
